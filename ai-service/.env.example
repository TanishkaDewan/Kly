# ============================================================
# Klyro AI Service Environment Variables (.env.example)
# Copy this file to .env and configure real credentials.
# NEVER commit private .env files containing real secrets.
# ============================================================

# GitHub API Token (personal access token for inspecting repos, commit history, AST, diffs)
# Configured in GitHub -> Developer Settings -> Personal Access Tokens (Classic or Fine-grained: public_repo read)
GITHUB_TOKEN=your_github_token_placeholder

# Google Gemini API Key (for LLM code evaluation across 6 rubric dimensions)
# Generated from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Gemini Model Identifier (e.g., gemini-2.5-flash or gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# Shared Internal Service Key
# Must match the AI_SERVICE_KEY configured in the Backend service for request authentication
AI_SERVICE_KEY=your_shared_internal_service_key_placeholder