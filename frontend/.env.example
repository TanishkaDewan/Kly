# ============================================================
# Klyro Frontend Environment Variables (.env.example)
# Copy this file to .env and configure real credentials.
# NEVER commit private .env files containing real secrets.
# NOTE: ONLY public keys (Vite prefixed) belong here.
# NEVER place backend secrets, Supabase service-role keys, GitHub tokens, or Gemini API keys here.
# ============================================================

# Backend API Base URL
# Local Development: http://localhost:5000
# Production: https://your-backend-api.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Supabase Public Configuration (Authentication & Public Client)
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
