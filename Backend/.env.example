# ============================================================
# Klyro Backend Environment Variables (.env.example)
# Copy this file to .env and configure real credentials.
# NEVER commit private .env files containing real secrets.
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS
# Local: http://localhost:5173
# Production: https://your-frontend-domain.vercel.app
FRONTEND_URL=http://localhost:5173

# Supabase Project Credentials
# Configured in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder

# AI Service Integration
# Local: http://localhost:8000
# Production: https://your-ai-service.onrender.com
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=your_shared_internal_service_key_placeholder
